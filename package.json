{
  "name": "oba-tales",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run data:check",
    "build": "tsc -b && vite build",
    "data:gen": "tsx scripts/generate-roster.ts",
    "data:gen:stress": "tsx scripts/generate-roster.ts --count 5000 --out public/data/roster.stress.json --no-season",
    "data:check": "tsx scripts/validate-data.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "tsx scripts/generate-og.ts",
    "modeller": "tsx scripts/export-models.ts",
    "blender:kit": "tsx scripts/export-models.ts && tsx scripts/blender/calistir.ts kit",
    "blender:aktar": "tsx scripts/blender/calistir.ts aktar && tsx scripts/blender/kontrol.ts",
    "blender:kontrol": "tsx scripts/blender/kontrol.ts",
    "model:cevir": "tsx scripts/obj-to-kit.ts",
    "takipci:ekle": "tsx scripts/import-followers.ts",
    "youtube:yorumlar": "tsx scripts/fetch-youtube-comments.ts",
    "deploy": "npm run build && npx wrangler@4 deploy"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.79.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.2",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
